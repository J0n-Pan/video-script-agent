# ===== 视频号信息流编导脚本编写 Agent 本地配置 =====
# 复制为 .env 后按需修改。密钥只保存在本文件，不下发浏览器、不写入 Excel、不进日志（PRD 11.2）。

# ---- 数据与媒体位置（可配置，PRD 10.3）----
DATABASE_URL="file:../data/app.db"  # 相对 prisma/schema.prisma 解析，实际落在项目 data/ 目录
MEDIA_DIR="./data/media"

# ---- 会话密钥（首次启动请改）----
SESSION_SECRET="change-me-local-only"

# ---- Web 服务端口（仅本机访问）----
PORT=3939

# ---- AI 适配器模式：mock | dashscope ----
# mock：用确定性桩实现跑通全链路，不产生费用，便于验收流程与导出格式
# dashscope：真实调用阿里云百炼三个模型（需下方 API Key）
AI_MODE="mock"

# ---- 阿里云百炼（PRD 10.5 已确认三模型）----
# 1) 在百炼控制台「API-KEY 管理」创建密钥，形如 sk-xxxxxxxx
# 2) 确认密钥所属区域，与下方 DASHSCOPE_REGION 保持一致（两站密钥不通用）
# 3) 确认业务空间已开通下列三个模型的调用权限
# 4) 先跑 `npm run check:ai` 验证，通过后再把 AI_MODE 改为 dashscope 并重启解析进程
DASHSCOPE_API_KEY=""
# beijing  = 中国站（华北2 北京）→ https://dashscope.aliyuncs.com
# singapore = 国际站（新加坡）   → https://dashscope-intl.aliyuncs.com
DASHSCOPE_REGION="beijing"
VISION_MODEL="qwen3-vl-plus"
ORGANIZE_MODEL="qwen3.8-flash"

# ---- 音频识别通道 ----
# PRD 原定 qwen3-asr-flash-filetrans，但该模型走异步任务、file_urls 只接受公网可访问地址，
# 本机部署（127.0.0.1）无法满足，实测 oss:// 与私有桶 https:// 都被判 InvalidParameter.MalformedURL。
# realtime = paraformer-realtime-v2，WebSocket 直推本地音频，返回句级时间戳（本机部署默认）
# filetrans = qwen3-asr-flash-filetrans，具备公网存储（如自建 OSS + 签名 URL）时可切回
ASR_TRANSPORT="realtime"
ASR_MODEL="paraformer-realtime-v2"
# 推流倍速：1=按真实速率。实测 1x 与 4x 的时间戳结果完全一致，故默认 4x 缩短等待
ASR_PUSH_SPEED="4"
# 句切分静音阈值（毫秒）：偏小易把一句切碎，偏大会合并多句
ASR_MAX_SENTENCE_SILENCE="800"
# 语种提示，仅作提示不限定；paraformer-realtime-v2 支持中(含方言)英日韩
ASR_LANGUAGE_HINTS="zh,en"
# 说话人分离：开启后返回 speakerId。不自动等同主体或旁白（PRD 10.6）
ASR_DIARIZATION="false"

# ---- 规则阈值（已确认项可配置，PRD 4.2）----
# 形式判定（2026-09-16 需求方口径）：AI 占比 ≥ 前者 → AI数字人；
# 真人占比 ≥ 后者（即 AI 占比 ≤ 1 - 后者）→ 真人；两者之间 → 其他
AI_VIDEO_RATIO_THRESHOLD="0.75"
REAL_PERSON_RATIO_THRESHOLD="0.75"
SCENE_CHANGE_THRESHOLD="0.35"
VISION_SAMPLE_COUNT="9"

# ---- 重试与超时（行为明确、数值待验证，PRD 8 / 14.1）----
MAX_ATTEMPT_RETRY="2"
RETRY_INTERVAL_MS="3000"
# 音频识别为实时推流，耗时与音频时长同阶（4x 倍速下约为时长的 0.25~0.8 倍）。
# 上限 30 分钟音频在最坏情况下需 7.5 分钟推流，故取 15 分钟。
STAGE_TIMEOUT_MS="900000"

# ---- 腾讯妙思专用会话（PRD 10.4）----
# 真实抓取依赖 playwright（npm install 已含）与一次人工扫码登录，三步启用：
#   1) npm run muse:login        打开浏览器，用微信/企业微信扫码登录一次，会话落盘
#   2) 把下面的 MUSE_FETCH_ENABLED 改为 "true"
#   3) 重启解析进程 npm run worker（独立进程不会自动加载 .env）
# 会话过期时抓取会明确返回「需重新登录」，不会伪装成获取成功；期间可本地补传视频。
# 排查工具：npm run muse:check（查会话是否有效）、npm run muse:probe -- "<链接>"（诊断单条素材）
MUSE_FETCH_ENABLED="false"
MUSE_STORAGE_STATE="./data/muse-session/state.json"
MUSE_LOGIN_URL="https://admuse.qq.com/"
# 抓取用无头模式；排查页面问题时设为 false 可用有头模式观察
MUSE_HEADLESS="true"
# 素材页等待媒体地址出现的最长时间（毫秒）
MUSE_WAIT_MS="20000"
MUSE_NAV_TIMEOUT_MS="45000"
# 允许的素材链接域名，逗号分隔
MUSE_ALLOWED_HOSTS="admuse.qq.com,ad.qq.com"

# ---- 初始账号口令（npm run db:seed 读取；请改成你自己的口令）----
# 未设置时种子脚本会退化为占位口令 change-me-before-deploy 并打印提醒
SEED_MAINTAINER_PASSWORD=""
SEED_EDITOR_PASSWORD=""
SEED_EDITOR2_PASSWORD=""
