# ===== 视频号信息流编导脚本编写 Agent 本地配置 =====
# 复制为 .env 后按需修改。密钥只保存在本文件，不下发浏览器、不写入 Excel、不进日志（PRD 11.2）。

# ---- 数据与媒体位置（可配置，PRD 10.3）----
DATABASE_URL="file:../data/app.db"  # 相对 prisma/schema.prisma 解析，实际落在项目 data/ 目录
MEDIA_DIR="./data/media"

# ---- 会话密钥（首次启动请改）----
SESSION_SECRET="change-me-local-only"

# ---- Web 服务端口（仅本机访问）----
PORT=3939

# ---- AI 适配器模式：mock | dashscope ----
# mock：用确定性桩实现跑通全链路，不产生费用，便于验收流程与导出格式
# dashscope：真实调用阿里云百炼三个模型（需下方 API Key）
AI_MODE="mock"

# ---- 阿里云百炼（PRD 10.5 已确认三模型）----
# 1) 在百炼控制台「API-KEY 管理」创建密钥，形如 sk-xxxxxxxx
# 2) 确认密钥所属区域，与下方 DASHSCOPE_REGION 保持一致（两站密钥不通用）
# 3) 确认业务空间已开通下列三个模型的调用权限
# 4) 先跑 `npm run check:ai` 验证，通过后再把 AI_MODE 改为 dashscope 并重启解析进程
DASHSCOPE_API_KEY=""
# beijing  = 中国站（华北2 北京）→ https://dashscope.aliyuncs.com
# singapore = 国际站（新加坡）   → https://dashscope-intl.aliyuncs.com
DASHSCOPE_REGION="beijing"
VISION_MODEL="qwen3-vl-plus"
ORGANIZE_MODEL="qwen3.8-flash"
# 个性化文案改写模型（2026-09-20 需求迭代）。留空则继承 ORGANIZE_MODEL。
# 换它不影响 ASR / 视觉 / 整理，也不需要换 API Key。单价表见 src/lib/config.ts 的 pricing.rewriteModels，
# 换模型后费用估算自动按新模型名取档，历史记录不会被新价格覆盖。
# 实测结论（四家横向对比，两轮共约 ¥0.23）：qwen3.8-flash 成本最低、字数最贴近参考段、三版差异明显，推荐；
# qwen3.7-plus 质量相当但贵约 3 倍；qwen3.8-max 明显偏贵且输出偏长。详细数据见 README 第 10.2 节。
REWRITE_MODEL="qwen3.8-flash"

# ---- 音频识别通道 ----
# PRD 原定 qwen3-asr-flash-filetrans，但该模型走异步任务、file_urls 只接受公网可访问地址，
# 本机部署（127.0.0.1）无法满足，实测 oss:// 与私有桶 https:// 都被判 InvalidParameter.MalformedURL。
# realtime = paraformer-realtime-v2，WebSocket 直推本地音频，返回句级时间戳（本机部署默认）
# filetrans = qwen3-asr-flash-filetrans，具备公网存储（如自建 OSS + 签名 URL）时可切回
ASR_TRANSPORT="realtime"
ASR_MODEL="paraformer-realtime-v2"
# 推流倍速：1=按真实速率。实测 1x 与 4x 的时间戳结果完全一致，故默认 4x 缩短等待
ASR_PUSH_SPEED="4"
# 句切分静音阈值（毫秒）：偏小易把一句切碎，偏大会合并多句
ASR_MAX_SENTENCE_SILENCE="800"
# 语种提示，仅作提示不限定；paraformer-realtime-v2 支持中(含方言)英日韩
ASR_LANGUAGE_HINTS="zh,en"
# 说话人分离：开启后返回 speakerId。不自动等同主体或旁白（PRD 10.6）
ASR_DIARIZATION="false"

# ---- 规则阈值（已确认项可配置，PRD 4.2）----
# 形式判定（2026-09-16 需求方口径）：AI 占比 ≥ 前者 → AI数字人；
# 真人占比 ≥ 后者（即 AI 占比 ≤ 1 - 后者）→ 真人；两者之间 → 其他
AI_VIDEO_RATIO_THRESHOLD="0.75"
REAL_PERSON_RATIO_THRESHOLD="0.75"
SCENE_CHANGE_THRESHOLD="0.35"
VISION_SAMPLE_COUNT="9"

# ---- 重试与超时（行为明确、数值待验证，PRD 8 / 14.1）----
MAX_ATTEMPT_RETRY="2"
RETRY_INTERVAL_MS="3000"
# 音频识别为实时推流，耗时与音频时长同阶（4x 倍速下约为时长的 0.25~0.8 倍）。
# 上限 30 分钟音频在最坏情况下需 7.5 分钟推流，故取 15 分钟。
STAGE_TIMEOUT_MS="900000"

# ---- 腾讯妙思专用会话（PRD 10.4；2026-09-22 起按用户隔离）----
# 真实抓取依赖 playwright（npm install 已含）与一次人工扫码登录，三步启用：
#   1) 登录：每个账号（编导 / 维护人员）各自登录工作台后，
#      页面会自动检查并弹出扫码窗口；也可在「我的妙思会话」页手动点「开始扫码登录」，
#      或在终端执行 npm run muse:login（默认给维护人员登录，--user=<用户名> 指定他人）。
#      会话按人落盘到 data/muse-session/users/<userId>/state.json。
#   2) 把下面的 MUSE_FETCH_ENABLED 改为 "true"
#   3) 重启解析进程 npm run worker（MUSE_FETCH_ENABLED 是进程启动时读取的）
#      ⚠️ 仅重新扫码登录不需要重启解析进程 —— 每次抓取都会重新读取会话文件。
# 会话过期时抓取会明确返回「需重新登录」，不会伪装成获取成功；期间可本地补传视频。
# 工作台页头会在**自己**的登录态失效时常驻提示；同一次登录内自动弹窗只弹一次，可「稍后再说」。
# MUSE_STORAGE_STATE 只是**老版全局会话**的路径与按用户目录的推导基准：
#   按用户目录是 <该文件所在目录>/users/<userId>/。
#   改动前的全局会话可用 npm run muse:migrate 复制到维护人员名下（幂等，不覆盖）。
# 排查工具：npm run muse:check（查会话是否有效）、npm run muse:probe -- "<链接>"（诊断单条素材）；
#   二者默认看维护人员的会话，要看别人的加 --user=<用户名>。
MUSE_FETCH_ENABLED="false"
MUSE_STORAGE_STATE="./data/muse-session/state.json"
MUSE_LOGIN_URL="https://admuse.qq.com/"
# 抓取用无头模式；排查页面问题时设为 false 可用有头模式观察
MUSE_HEADLESS="true"
# 素材页等待媒体地址出现的最长时间（毫秒）
MUSE_WAIT_MS="20000"
MUSE_NAV_TIMEOUT_MS="45000"
# 允许的素材链接域名，逗号分隔
MUSE_ALLOWED_HOSTS="admuse.qq.com,ad.qq.com"
# 登录态结论的有效期（毫秒，默认 15 分钟）。
# 工作台只在「打开页面且结论已过期」时重新探测，避免在页面之间点来点去就反复探测。
# 探测优先走零成本判据：state.json 里会话 cookie 自带的到期时间；
# 只有无法零成本定罪时才真的开一次无头浏览器（约 4 秒）。
MUSE_HEALTH_TTL_MS="900000"

# ---- 个性化文案改写（2026-09-20 需求迭代 §5）----
# 用「参考视频的脚本 + IP 资料包」生成结构严格一致的自有 IP 口播稿，供编导复核后送数字人。
# 与视频分析链路解耦：只烧文本 token，不重跑 ASR 与画面理解。
# 一次点击生成几个版本（默认 3）。多版本靠表达差异，**不允许靠改段落数/顺序/标签制造差异**。
REWRITE_VARIANT_COUNT="3"
# 投放平台：影响措辞与沿用参考段既有行动引导的表达，**不新增/删除引导**（WECHAT_CHANNELS / DOUYIN / ...）
REWRITE_PLATFORM="WECHAT_CHANNELS"
# 单次生成要写 3 篇长文，给足超时但有限等待（毫秒）
REWRITE_TIMEOUT_MS="600000"
REWRITE_MAX_OUTPUT_TOKENS="16000"
# 多版本需要表达差异：温度偏高，但结构由程序裁决，不靠随机性放松约束
REWRITE_TEMPERATURE="0.85"
REWRITE_TOP_P="0.9"

# ---- 鲲之益数字人（2026-09-20 需求迭代 §7）----
# 官方 API 尚未确认，首版走 Playwright 驱动网页；会话**独立于妙思**（不同站点、不同账号，
# 混用同一个会话文件会让两边登录态互相覆盖）。启用三步：
#   1) npm run avatar:login      打开浏览器扫码登录一次，会话落盘 data/avatar-session/state.json
#   2) 把下面的 AVATAR_ADAPTER 改为 "playwright"
#   3) 单独启动数字人进程 npm run worker:avatar（独立单实例锁，不占用全局视频分析队列）
# 会话失效时明确返回「需重新登录」，不伪装成提交成功；期间可把 AVATAR_ADAPTER 切回 mock 跑通流程。
# 排查：npm run avatar:check（会话是否有效）
#      npm run avatar:smoke（**零额度预检**：真实账号把创建页表单填一遍但不点提交，
#                            用来验证页面选择器是否还和平台一致。先跑它，再考虑真提交）
AVATAR_ADAPTER="mock"
AVATAR_BASE_URL="https://aigc.huweilai.cn"
AVATAR_CREATE_PATH="/dashboard/to-create-video"
AVATAR_WORKS_PATH="/digital-human/digital-video"
AVATAR_STORAGE_STATE="./data/avatar-session/state.json"
AVATAR_HEADLESS="true"
AVATAR_NAV_TIMEOUT_MS="45000"
AVATAR_ACTION_TIMEOUT_MS="60000"
# 默认形象与音色（§1.1）。**必须唯一匹配**：找不到 / 重名 / 资产被移除时明确报错，
# 绝不静默换成别的形象或声音（验收项 A13）。
AVATAR_NAME="李威老师_场景1_书房坐姿"
AVATAR_VOICE="李威老师"
AVATAR_LANGUAGE="中文"
AVATAR_SPEED="1.0"
AVATAR_VOLUME="1.0"
AVATAR_SUBTITLE="false"
AVATAR_BGM="false"
# 「成片保存至」的目标文件夹 —— **提交前的必填项**（2026-09-20 实测）。
# 创建页右上角有个文件夹下拉，不选它「生成视频」按钮会一直处于禁用状态：
# 形象/音色/文本/作品名全填好也一样。所以这里必须显式配置，不能猜（会把成片存进别人目录）。
# 用 npm run avatar:smoke 可以看到当前账号下有哪些可选文件夹。
AVATAR_SAVE_FOLDER="李威数字人"
# 轮询平台任务状态
AVATAR_POLL_INTERVAL_MS="15000"
AVATAR_POLL_TIMEOUT_MS="1800000"
# 提交方式（2026-09-22 新增，只在 AVATAR_ADAPTER="playwright" 下有意义）
#   auto   —— 全自动：适配器自己选形象/音色/参数/文件夹并点「生成视频」（默认，行为与之前一致）
#   assist —— 人工接手：只预填**作品名与文案**，数字人进程会弹出一个真实浏览器窗口停在创建页，
#             由编导自己挑形象和各项参数、自己点「生成视频」。
# 为什么留 assist：自动提交最脆的几段恰好都在「替平台做参数校验」上（形象/音色唯一匹配、
# 参数滑杆、必填文件夹、按钮可用性）——这些选择器平台一改版就崩，报出来的却是
# 「视频生成失败，请检查配置参数」这种没法诊断的泛化错误。交给平台自己的 UI 去校验更稳。
# 注意：assist 模式下浏览器窗口开在**运行数字人进程的那台机器**上，需要有人能操作那个桌面。
AVATAR_SUBMIT_MODE="auto"
# assist 模式下等编导操作的上限（毫秒）。超时后按「回查作品列表」判定是否真的提交过：
# 查到 = 生成中；查不到 = 人工接手已取消（确定没提交，可直接重新发起）。
AVATAR_ASSIST_TIMEOUT_MS="1800000"
# 平台单次文本上限（**尚未核实**，先给保守值）。超限时提示编导处理，
# **不自动拆成多个任务、也不删减文案**（§7.3）。
AVATAR_MAX_TEXT_CHARS="5000"
# 只接受这些域名的成品链接，避免把任意输入当服务器路径读取。
# 注意：**成品 mp4 在阿里云 OSS 上**（实测 kzyszross.oss-cn-beijing.aliyuncs.com），
# 不在 aigc.huweilai.cn；云存储后缀（.aliyuncs.com / .myqcloud.com 等）已在代码里默认放行，
# 这里只需补充平台可能新启用的其他域名。
AVATAR_ALLOWED_HOSTS="aigc.huweilai.cn"
# 成品持久化目录（不只依赖第三方下载链接，§7.5；删除任务不级联删除导出记录）
AVATAR_VIDEO_DIR="./data/avatars"

# ---- 初始账号口令（npm run db:seed 读取；请改成你自己的口令）----
# 未设置时种子脚本会退化为占位口令 change-me-before-deploy 并打印提醒
SEED_MAINTAINER_PASSWORD=""
SEED_EDITOR_PASSWORD=""
SEED_EDITOR2_PASSWORD=""
# 多人测试部署时追加编导账号（可选）：用户名:口令:显示名，多条用英文逗号分隔
# 例：SEED_EXTRA_EDITORS="zhangsan:各自口令:张三,lisi:各自口令:李四"
SEED_EXTRA_EDITORS=""
